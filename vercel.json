{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/sic",
      "destination": "/suministros.html",
      "permanent": true
    },
    {
      "source": "/sic/",
      "destination": "/suministros.html",
      "permanent": true
    },
    {
      "source": "/Vidriosyaluminiosenvalledupar",
      "destination": "/vidrio-aluminio-acero.html",
      "permanent": true
    },
    {
      "source": "/Vidriosyaluminiosenvalledupar/",
      "destination": "/vidrio-aluminio-acero.html",
      "permanent": true
    },
    {
      "source": "/vidriosyaluminiosenvalledupar",
      "destination": "/vidrio-aluminio-acero.html",
      "permanent": true
    },
    {
      "source": "/vidriosyaluminiosenvalledupar/",
      "destination": "/vidrio-aluminio-acero.html",
      "permanent": true
    },
    {
      "source": "/about-us(/.*)?",
      "destination": "/nosotros.html",
      "permanent": true
    },
    {
      "source": "/contact-us(/.*)?",
      "destination": "/contacto.html",
      "permanent": true
    },
    {
      "source": "/mapa(/.*)?",
      "destination": "/proyectos.html#mapa",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-fachadas(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#fachadas",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-puertas(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#puertas",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-barandas-en-vidrios-y-acero-inoxidable(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#barandas",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-division-de-banos(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#banos",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-division-de-oficina(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#oficina",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-espejos(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#espejos",
      "permanent": true
    },
    {
      "source": "/galeria-de-imagenes-aluminio-arquitectonico(/.*)?",
      "destination": "/vidrio-aluminio-acero.html#aluminio",
      "permanent": true
    },
    {
      "source": "/product-category/geosistemas(/.*)?",
      "destination": "/suministros.html#cat-geosistemas",
      "permanent": true
    },
    {
      "source": "/product-category/tubosistemas(/.*)?",
      "destination": "/suministros.html#cat-tubosistemas",
      "permanent": true
    },
    {
      "source": "/product-category/linea-agua(/.*)?",
      "destination": "/suministros.html#cat-linea-agua",
      "permanent": true
    },
    {
      "source": "/product-category(/.*)?",
      "destination": "/suministros.html#catalogo",
      "permanent": true
    },
    {
      "source": "/product(/.*)?",
      "destination": "/suministros.html#catalogo",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
